{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flop-agent",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "triggers": {
    // 3時間ごと（8回/日）。Cloudflareのcronはベストエフォートで飛ぶことがあるため、
    // 1回の取りこぼしでは警報にしない密度にしてある。ルーム発言は1日1回だけ。
    "crons": ["17 */3 * * *"]
  },
  "kv_namespaces": [
    { "binding": "FLOP_STATE", "id": "8758ee9f551948ec9cfeb15870138917" }
  ],
  // 🔴 MONITOR_URL below is redacted for publication, and `--keep-vars` is NOT enough to
  //    protect it. Measured 2026-09-04: `wrangler deploy --keep-vars` still applied the
  //    placeholder from this file and the heartbeat began returning 404 against example.com.
  //    --keep-vars only stops wrangler deleting vars that are ABSENT from the file; a var that
  //    is present in the file is pushed regardless. Deploy from a private copy of this config
  //    carrying your real endpoint, then verify with `/run?key=` that ping.ok is true — the
  //    monitor going quiet is the exact failure this agent exists to make impossible.
  "vars": {
    "FLOP_BASE": "https://technocore.chat",
    "FLOP_ROOM": "technocore",
    "FLOP_NOTES_URL": "https://github.com/justin201507-rgb/technocore-field-notes",
    "FLOP_DID": "did:key:z6Mkvt9UGK1LuwiXyRKj1EqavL534589MHoWzutQAPULLF3F",
    "MONITOR_URL": "https://example.com/your-monitor-endpoint",
    "MONITOR_JOB": "flop-agent-daily",
    "MONITOR_EVERY": "180"
  }
}
